// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  password           String
  role               Role                 @default(USER) // New field to define admin or user
  createdAt          DateTime             @default(now())
  isVerified         Boolean              @default(false)
  verificationToken  String?
  hasTakenDiagnostic Boolean              @default(false) // ✅ Add this
  lessonPriorities   UserLessonPriority[]
  diagnosticAnswers  DiagnosticAnswer[] // ✅ Add this line
  assessmentAnswers  AssessmentAnswer[]
  userSkillPerformances UserSkillPerformance[]
}

enum Role {
  USER
  ADMIN
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

model Chapter {
  id      String   @id @default(uuid())
  title   String
  order   Int // ✅ NEW: defines display order of chapters
  lessons Lesson[]
}

enum AssessmentType {
  PRE
  POST
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model Lesson {
  id                String               @id @default(uuid())
  title             String
  order             Int // ✅ NEW: defines order within chapter
  media             String? @db.Text // ✅ Stores image or video URLs (nullable)
  chapterId         String
  chapter           Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions         Question[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  lessonPriorities  UserLessonPriority[] @relation("LessonToPriority")
  pages             LessonPage[] // ⬅️ add this relation
  diagnosticAnswers DiagnosticAnswer[] // ✅ Add this line
  status            LessonStatus         @default(DRAFT) // 👈 add this
  assessmentAnswers AssessmentAnswer[]
  exampleExercises  ExampleExercise[]
  userSkillPerformances UserSkillPerformance[] // New relation to track user skill performance
}

model Question {
  id                String             @id @default(uuid())
  lessonId          String
  lesson            Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question          String?
  questionImage     String? // ✅ image file path
  choices           String[] // Array of choices
  isChoiceImage     Boolean            @default(false) // ✅ whether choices are images
  correctAnswer     String
  skillTag       String?  // ✅ Add this line
  diagnosticAnswers DiagnosticAnswer[] // ✅ Add this line
  assessmentAnswers AssessmentAnswer[]
}

model UserLessonPriority {
  id          String @id @default(uuid())
  userId      String
  lessonId    String
  priority    Float // Computed priority value
  progress    Float  @default(0.0) // ✅ Track per-user progress here
  currentPage Int? // 👈 ✅ Track user page progress

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation("LessonToPriority", fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId]) // Prevent duplicates
}

model LessonPage {
  id       String  @id @default(uuid())
  content  String // markdown or html
  media    String? // optional image or video
  order    Int // page order in the lesson
  lessonId String
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order]) // ✅ required for upsert to work
}

model DiagnosticAnswer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  lessonId   String
  timeTaken  Int // in seconds
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model AssessmentAnswer {
  id         String         @id @default(uuid())
  userId     String
  lessonId   String
  questionId String
  timeTaken  Int
  isCorrect  Boolean
  type       AssessmentType
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}


model ExampleExercise {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question     String   // Markdown or HTML (for question/problem statement)
  choices     String[] // Multiple choice options
  correctAnswer String
  explanation String? // Why the answer is correct or incorrect
  skillTag    String?  // Optional: "mapping", "domain", etc.
  difficulty  DifficultyLevel @default(MEDIUM)
  isChoiceImage Boolean @default(false)
  questionImage String? // optional image for the exercise
  createdAt   DateTime @default(now())
}

model UserSkillPerformance {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  skillTag      String
  source        String   // "DIAGNOSTIC" or "PRE"
  averageScore  Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId, skillTag, source])
}
