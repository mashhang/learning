// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  password           String
  role               Role                 @default(USER) // New field to define admin or user
  createdAt          DateTime             @default(now())
  isVerified         Boolean              @default(false)
  verificationToken  String?
  hasTakenDiagnostic Boolean              @default(false) // ✅ Add this
  lessonPriorities   UserLessonPriority[]
}

enum Role {
  USER
  ADMIN
}

model Chapter {
  id      String   @id @default(uuid())
  title   String
  lessons Lesson[]
}

model Lesson {
  id               String               @id @default(uuid())
  title            String
  content          String
  media            String? // ✅ Stores image or video URLs (nullable)
  chapterId        String
  chapter          Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions        Question[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  lessonPriorities UserLessonPriority[]
}

model Question {
  id            String   @id @default(uuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String?
  questionImage String? // ✅ image file path
  choices       String[] // Array of choices
  isChoiceImage Boolean  @default(false) // ✅ whether choices are images
  correctAnswer String
}

model UserLessonPriority {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  priority  Float // Computed priority value
  progress  Float    @default(0.0) // ✅ Track per-user progress here
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId]) // Prevent duplicates
}